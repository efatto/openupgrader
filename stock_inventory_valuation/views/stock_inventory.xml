<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="stock_inventory_line_tree" model="ir.ui.view">
        <field name="name">view.inventory.line.valuation</field>
        <field name="model">stock.inventory.line</field>
        <field name="inherit_id" ref="stock.stock_inventory_line_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="valuation_price_unit" />
                <field name="valuation_price_subtotal" />
            </xpath>
        </field>
    </record>
    <record id="view_inventory_form" model="ir.ui.view">
        <field name="name">view.inventory.form.valuation</field>
        <field name="model">stock.inventory</field>
        <field name="inherit_id" ref="stock.view_inventory_form" />
        <field name="arch" type="xml">
            <field name="accounting_date" position="after">
                <button
          name="product_recalculate_value"
          string="Compute costs with method:"
          type="object"
          attrs="{'invisible': [('state', 'in', ['draft', 'cancel'])]}"
        />
                <field
          name="valuation_type"
          nolabel="1"
          attrs="{'invisible': [('state', 'in', ['draft', 'cancel'])]}"
        />
            </field>
        </field>
    </record>
</odoo>
