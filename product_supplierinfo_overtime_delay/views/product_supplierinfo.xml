<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_supplierinfo_form_view" model="ir.ui.view">
        <field name="name">product.supplierinfo.form.view</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="product.product_supplierinfo_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='vendor']" position="inside">
                <label for="overtime_purchase_delay" />
                <div>
                    <field name="overtime_purchase_delay" class="oe_inline" />
                </div>
            </xpath>
            <xpath expr="//form/sheet/group" position="before">
                <field name="overtime_move_ids" invisible="True" />
                <div class="oe_button_box" name="button_box">
                    <button
            name="open_view_stock_move_overtime"
            type="object"
            class="oe_stat_button"
            icon="fa-list"
            string="Overtime Moves"
            groups="stock.group_stock_user"
            attrs="{'invisible': [('overtime_move_ids', '=', False)]}"
          >
                    </button>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
