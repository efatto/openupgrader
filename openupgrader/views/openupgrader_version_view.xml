<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_odoo_version_search" model="ir.ui.view">
        <field name="name">odoo.version.search</field>
        <field name="model">odoo.version</field>
        <field name="arch" type="xml">
            <search string="Odoo Version Search">
                <field name="name" />
                <field name="python_version" />
            </search>
        </field>
    </record>

    <record id="view_odoo_version_tree" model="ir.ui.view">
        <field name="name">odoo.version.tree</field>
        <field name="model">odoo.version</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="python_version" />
            </tree>
        </field>
    </record>

    <record id="view_odoo_version_form" model="ir.ui.view">
        <field name="name">odoo.version.form</field>
        <field name="model">odoo.version</field>
        <field name="arch" type="xml">
            <form string="Odoo Version">
                <header>
                    <button
                        name="button_create_venv"
                        type="object"
                        string="Create or update virtualenv"
                    />
                    <button
                        name="button_recreate_venv"
                        type="object"
                        string="Re-create virtualenv"
                        help="To recreate a clean virtualenv after removing some repos or libraries"
                    />
                </header>
                <sheet string="Odoo Version">
                    <group>
                        <field name="name" />
                        <field name="python_version" />
                    </group>
                    <group>
                        <field name="module_installed_ids" />
                        <field name="openupgrader_repo_ids" />
                        <field name="openupgrader_config_ids" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_odoo_version" model="ir.actions.act_window">
        <field name="name">Odoo Version</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">odoo.version</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record model="ir.ui.menu" id="menu_odoo_version">
        <field name="name">Odoo Version</field>
        <field name="sequence" eval="25" />
        <field name="parent_id" ref="menu_openupgrader" />
        <field name="action" ref="action_odoo_version" />
    </record>
</odoo>
