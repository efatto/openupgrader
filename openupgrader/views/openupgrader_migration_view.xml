<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_openupgrader_migration_search" model="ir.ui.view">
        <field name="name">openupgrader.migration.search</field>
        <field name="model">openupgrader.migration</field>
        <field name="arch" type="xml">
            <search string="OpenUpgrader migration Search">
                <field name="db_name" />
                <field name="from_version_id" />
                <field name="to_version_id" />
            </search>
        </field>
    </record>

    <record id="view_openupgrader_migration_tree" model="ir.ui.view">
        <field name="name">openupgrader.migration.tree</field>
        <field name="model">openupgrader.migration</field>
        <field name="arch" type="xml">
            <tree>
                <field name="db_name" />
                <field name="from_version_id" />
                <field name="to_version_id" />
            </tree>
        </field>
    </record>

    <record id="view_openupgrader_migration_form" model="ir.ui.view">
        <field name="name">openupgrader.migration.form</field>
        <field name="model">openupgrader.migration</field>
        <field name="arch" type="xml">
            <form string="OpenUpgrader migration">
                <header>
                    <button name="button_draft" type="object" string="Set to draft" />
                    <button
                        name="button_restore_update"
                        type="object"
                        string="1&amp;2: restore and update"
                        help="Restore and update db of current version before migration, alternative to use the two separated buttons"
                    />
                    <button
                        name="button_restore"
                        type="object"
                        class="oe_highlight"
                        attrs="{'invisible': [('state', '!=', 'created_venv')]}"
                        string="1: restore"
                        help="Restore db of current version before migration"
                    />
                    <button
                        name="button_restore"
                        type="object"
                        attrs="{'invisible': [('state', '=', 'created_venv')]}"
                        string="1: restore"
                        help="Restore db of current version before migration"
                    />
                    <button
                        name="button_update_current_version"
                        type="object"
                        class="oe_highlight"
                        attrs="{'invisible': [('state', '!=', 'restored')]}"
                        string="2: update"
                        help="Update db of current version before migration"
                    />
                    <button
                        name="button_update_current_version"
                        type="object"
                        attrs="{'invisible': [('state', '=', 'restored')]}"
                        string="2: update"
                        help="Update db of current version before migration"
                    />
                    <button
                        name="button_prepare_for_migration"
                        type="object"
                        class="oe_highlight"
                        attrs="{'invisible': ['|', ('state', 'not in', ['updated', 'done']), ('next_version_id', '=', False)]}"
                        string="3: prepare migration"
                        help="Do some useful stuff before migration"
                    />
                    <button
                        name="button_prepare_for_migration"
                        type="object"
                        attrs="{'invisible': ['|', ('state', 'in', ['updated', 'done']), ('next_version_id', '=', False)]}"
                        string="3: prepare migration"
                        help="Do some useful stuff before migration"
                    />
                    <button
                        name="button_do_migration"
                        type="object"
                        class="oe_highlight"
                        attrs="{'invisible': ['|', ('state', '!=', 'ready_for_migration'), ('next_version_id', '=', False)]}"
                        string="4: migrate"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,created_venv,restoring,restore_failed,restored,ready_for_migration,migrating,failed,migrated,done"
                    />
                </header>
                <sheet string="OpenUpgrader migration">
                    <group>
                        <group>
                            <field name="from_version_id" />
                            <field name="to_version_id" />
                            <field name="current_version_id" />
                            <field name="next_version_id" />
                            <field name="filestore" />
                            <field name="folder" />
                            <field name="openupgrade_repo" />
                        </group>
                        <group>
                            <field name="db_port" />
                            <field name="xmlrpc_port" />
                            <field name="db_name" />
                            <field name="db_user" />
                            <field name="db_password" password="1" />
                            <field name="pg_host" />
                            <field name="pg_options" />
                            <field name="pg_user" />
                            <field name="pg_password" password="1" />
                            <field name="pg_password_var" />
                        </group>
                        <group>
                            <field name="odoo_migrated_state" />
                        </group>
                        <group>
                            <group>
                                <field name="migrated_file"/>
                            </group>
                            <group>
                                <button
                                    name="button_upload_migrated_file"
                                    type="object"
                                    string="Upload migrated file"
                                />
                            </group>
                        </group>
                        <group colspan="4" col="2">
                            <group string="Utilities" />
                            <group colspan="2" col="4">
                                <button
                                    name="button_refresh_state"
                                    type="object"
                                    string="Refresh state and log"
                                />
                                <button
                                    name="button_clean_migration_error_log"
                                    type="object"
                                    string="Clean migration log"
                                />
                                <button
                                    name="button_start_odoo"
                                    type="object"
                                    string="Start Odoo (current migrated version)"
                                />
                                <button
                                    name="button_stop_odoo"
                                    type="object"
                                    string="Stop Odoo"
                                />
                            </group>
                        </group>
                    </group>
                    <group>
                        <field name="disabled_cron_ids" />
                    </group>
                    <group>
                        <field name="odoo_error_log" />
                        <field name="migration_error_log" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_openupgrader_migration" model="ir.actions.act_window">
        <field name="name">OpenUpgrader migration</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">openupgrader.migration</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record model="ir.ui.menu" id="menu_openupgrader">
        <field name="name">OpenUpgrader</field>
        <field name="sequence" eval="10" />
        <field name="parent_id" ref="base.menu_custom" />
        <field name="groups_id" eval="[(6,0, [ref('base.group_erp_manager')])]" />
    </record>

    <record model="ir.ui.menu" id="menu_openupgrader_migration">
        <field name="name">OpenUpgrader Migration</field>
        <field name="sequence" eval="10" />
        <field name="parent_id" ref="menu_openupgrader" />
        <field name="action" ref="action_openupgrader_migration" />
    </record>
</odoo>
