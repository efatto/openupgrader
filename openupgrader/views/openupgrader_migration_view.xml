<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_openupgrader_migration_search" model="ir.ui.view">
        <field name="name">openupgrader.migration.search</field>
        <field name="model">openupgrader.migration</field>
        <field name="arch" type="xml">
            <search string="OpenUpgrader Migration Search">
                <field name="db_name" />
                <field name="from_version_id" />
                <field name="to_version_id" />
            </search>
        </field>
    </record>

    <record id="view_openupgrader_migration_tree" model="ir.ui.view">
        <field name="name">openupgrader.migration.tree</field>
        <field name="model">openupgrader.migration</field>
        <field name="arch" type="xml">
            <tree>
                <field name="db_name" />
                <field name="from_version_id" />
                <field name="to_version_id" />
            </tree>
        </field>
    </record>

    <record id="view_openupgrader_migration_form" model="ir.ui.view">
        <field name="name">openupgrader.migration.form</field>
        <field name="model">openupgrader.migration</field>
        <field name="arch" type="xml">
            <form string="OpenUpgrader Migration">
                <header>
                    <field name="is_migration_done" invisible="1" />
                    <button name="button_draft" type="object" string="Set to draft" />
                    <button
                        name="button_restore"
                        type="object"
                        class="oe_highlight"
                        attrs="{'invisible': [('state', '!=', 'draft')]}"
                        string="1: restore"
                        help="Restore db of current version before migration"
                    />
                    <button
                        name="button_update_current_version"
                        type="object"
                        class="oe_highlight"
                        attrs="{'invisible': [('state', '!=', 'restored')]}"
                        string="2: update (click until this disappears)"
                        help="Update db of current version before migration"
                    />
                    <button
                        name="button_update_current_version"
                        type="object"
                        attrs="{'invisible': [('state', 'in', ['draft', 'restored', 'updated', 'ready_for_migration'])]}"
                        string="2: update (if the process has failed)"
                        help="Update db of current version before migration"
                    />
                    <button
                        name="button_prepare_for_migration"
                        type="object"
                        class="oe_highlight"
                        attrs="{'invisible': ['|', '|', ('state', 'not in', ['updated', 'migrated']), ('next_version_id', '=', False), ('is_migration_done', '=', True)]}"
                        string="3: prepare migration"
                        help="Do some useful stuff before migration"
                    />
                    <button
                        name="button_prepare_for_migration"
                        type="object"
                        attrs="{'invisible': ['|', '|', ('state', 'in', ['updated', 'migrated', 'restored', 'ready_for_migration']), ('next_version_id', '=', False), ('is_migration_done', '=', True)]}"
                        string="3: prepare migration"
                        help="Do some useful stuff before migration"
                    />
                    <button
                        name="button_do_migration"
                        type="object"
                        class="oe_highlight"
                        attrs="{'invisible': ['|', ('state', '!=', 'ready_for_migration'), ('next_version_id', '=', False)]}"
                        string="4: migrate (re-click until this disappears)"
                    />
                    <button
                        name="button_do_migration"
                        type="object"
                        attrs="{'invisible': ['|', ('state', 'not in', ['failed', 'restored']), ('next_version_id', '=', False)]}"
                        string="4: migrate (if the process has failed)"
                    />
                    <button
                        name="button_do_all"
                        type="object"
                        string="Do auto-migration"
                        help="I feel lucky!"
                        attrs="{'invisible': [('state', '!=', 'draft')]}"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,restore_failed,restored,ready_for_migration,failed,migrated,done"
                    />
                </header>
                <sheet string="OpenUpgrader Migration">
                    Migration for
                    <h1>
                        <field name="db_name" />
                    </h1>
                    <group>
                        <group>
                            <field
                                name="from_version_id"
                                context="{'default_openupgrader_migration_id': active_id} "
                            />
                            <field
                                name="to_version_id"
                                context="{'default_openupgrader_migration_id': active_id}"
                            />
                            <field
                                name="current_version_id"
                                context="{'default_openupgrader_migration_id': active_id}"
                            />
                            <field
                                name="next_version_id"
                                context="{'default_openupgrader_migration_id': active_id}"
                            />
                            <field name="migrate_filestore" />
                            <field name="folder" />
                            <field name="openupgrade_repo" />
                            <field name="config_file" filename="config_file_name" />
                            <field name="config_file_name" invisible="1" />
                        </group>
                        <group>
                            <field name="db_port" />
                            <field name="xmlrpc_port" />
                            <field name="db_name" />
                            <field name="db_user" />
                            <field name="db_password" password="1" />
                            <field name="pg_host" />
                            <field name="pg_options" />
                            <field name="pg_user" />
                            <field name="pg_password" password="1" />
                            <field name="pg_password_var" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Migration info">
                            <group>
                                <field name="uninstalled_modules" />
                                <field name="uninstallable_modules" />
                                <field name="disabled_cron_ids_set" />
                                <field name="disabled_ir_mail_server_ids_set" />
                                <field name="disabled_fetchmail_server_ids_set" />
                            </group>
                        </page>
                        <page string="Logs">
                            <button
                                name="button_get_logs"
                                type="object"
                                string="Get errors and warnings in log"
                            />
                            <p />
                            <separator string="Migration Critical Logs" />
                            <field name="migration_critical_log" nolabel="1" />
                            <separator string="Migration Error Logs" />
                            <field name="migration_error_log" nolabel="1" />
                            <separator string="Migration Warning Logs" />
                            <field name="migration_warning_log" nolabel="1" />
                            <separator string="Update Critical Logs" />
                            <field name="update_critical_log" nolabel="1" />
                            <separator string="Update Error Logs" />
                            <field name="update_error_log" nolabel="1" />
                            <separator string="Update Warning Logs" />
                            <field name="update_warning_log" nolabel="1" />
                            <button
                                name="button_clean_logs"
                                type="object"
                                string="Clean migration log"
                            />
                        </page>
                        <page string="Utilities">
                            <group>
                                <group
                                    colspan="2"
                                    col="1"
                                    string="Environment management"
                                >
                                    <button
                                        name="button_recreate_all_env"
                                        type="object"
                                        string="Recreate all environments"
                                    />
                                </group>
                                <group colspan="2" col="1" string="Dump utilities">
                                    <button
                                        name="button_dump_current_database"
                                        type="object"
                                        string="Dump current migrating database"
                                    />
                                    <p />
                                    <button
                                        name="button_restore_last_database"
                                        type="object"
                                        string="Restore last database dump"
                                    />
                                    <p />
                                    <button
                                        name="button_backup_migration"
                                        type="object"
                                        string="Generate final migration backup"
                                    />
                                </group>
                                <group
                                    colspan="2"
                                    col="1"
                                    string="Odoo migrating instance utilities"
                                >
                                    <button
                                        name="button_start_odoo"
                                        type="object"
                                        string="Start Odoo (current migrated version)"
                                    />
                                    <p />
                                    <button
                                        name="button_stop_odoo"
                                        type="object"
                                        string="Stop Odoo"
                                    />
                                </group>
                                <group>
                                    <field name="odoo_migrated_state" readonly="True" />
                                    <div
                                        class="alert alert-warning"
                                        role="alert"
                                        attrs="{'invisible': [('odoo_migrated_state', '=', 'stopped')]}"
                                        style="margin-bottom:0;"
                                    >
                                        <p>
                                            <i class="fa fa-info-circle" />
                                            <span>Migration is running!</span>
                                        </p>
                                    </div>
                                    <group colspan="2" col="1">
                                        <button
                                            name="button_check_odoo_migrated_running_state"
                                            type="object"
                                            string="Check migration running state"
                                        />
                                        <p />
                                        <button
                                            name="button_refresh_odoo_migrated_state"
                                            type="object"
                                            string="Refresh migration state"
                                        />
                                    </group>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_openupgrader_migration" model="ir.actions.act_window">
        <field name="name">OpenUpgrader Migration</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">openupgrader.migration</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record model="ir.ui.menu" id="menu_openupgrader">
        <field name="name">OpenUpgrader</field>
        <field name="sequence" eval="10" />
        <field name="parent_id" ref="base.menu_custom" />
        <field name="groups_id" eval="[(6,0, [ref('base.group_erp_manager')])]" />
    </record>

    <record model="ir.ui.menu" id="menu_openupgrader_migration">
        <field name="name">OpenUpgrader Migration</field>
        <field name="sequence" eval="10" />
        <field name="parent_id" ref="menu_openupgrader" />
        <field name="action" ref="action_openupgrader_migration" />
    </record>
</odoo>
