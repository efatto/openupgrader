<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="link_tracker_view_form" model="ir.ui.view">
        <field name="model">link.tracker</field>
        <field name="inherit_id" ref="link_tracker.link_tracker_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
          type="object"
          class="oe_stat_button"
          name="action_view_mailing_partners"
          icon="fa-bar-chart-o"
        >
                    <field
            name="mailing_partners_count"
            string="Mailing Partners"
            widget="statinfo"
          />
                </button>
                <button
          type="object"
          class="oe_stat_button"
          name="action_view_campaign_partners"
          icon="fa-bar-chart-o"
        >
                    <field
            name="campaign_partners_count"
            string="Campaign Partners"
            widget="statinfo"
          />
                </button>
                <button
          type="object"
          class="oe_stat_button"
          name="action_view_source_partners"
          icon="fa-bar-chart-o"
        >
                    <field
            name="source_partners_count"
            string="Source Partners"
            widget="statinfo"
          />
                </button>
            </xpath>
        </field>
    </record>
    <record id="link_tracker_view_tree" model="ir.ui.view">
        <field name="model">link.tracker</field>
        <field name="inherit_id" ref="link_tracker.link_tracker_view_tree" />
        <field name="arch" type="xml">
            <field name="count" position="before">
                <field name="mailing_partners_count" string="Mailing Partners" />
                <field name="campaign_partners_count" string="Campaign Partners" />
                <field name="source_partners_count" string="Source Partners" />
            </field>
        </field>
    </record>
</odoo>
