<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_sale_order_calendar_state_report_tree" model="ir.ui.view">
        <field name="name">Sale order calendar state report tree</field>
        <field name="model">sale.order.calendar.state.report</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="calendar_state" />
                <field name="production_id" />
                <field name="production_date_planned_start" />
                <field name="production_qty" sum="Total Production Qty" />
                <field name="amount_untaxed" sum="Total Amount Untaxed" />
            </tree>
        </field>
    </record>
    <record id="view_sale_order_calendar_state_report_search" model="ir.ui.view">
        <field name="name">Search for Sale order calendar state report</field>
        <field name="model">sale.order.calendar.state.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="calendar_state" />
                <field name="production_date_planned_start" />
                <filter
          name="filter_production_date_planned_start"
          string="Production date planned start: From Last Month"
          domain="[('production_date_planned_start', '&gt;=', (context_today().replace(day=1) + relativedelta(months=-1)).strftime('%Y-%m-%d'))]"
        />
                <filter
          string="Group by Production Date Planned start"
          name="groupby_production_date_planned_start"
          context="{'group_by': 'production_date_planned_start'}"
        />
                <filter
          string="Group by Calendar State"
          name="groupby_calendar_state"
          context="{'group_by': 'calendar_state'}"
        />
            </search>
        </field>
    </record>

    <record id="view_sale_order_calendar_state_report_graph" model="ir.ui.view">
        <field name="name">Sale order calendar state report: Graph</field>
        <field name="model">sale.order.calendar.state.report</field>
        <field name="arch" type="xml">
            <graph>
                <field name="production_id" />
                <field name="calendar_state" />
                <field name="production_date_planned_start" />
                <field name="production_qty" type="measure" />
            </graph>
        </field>
    </record>

    <record id="view_sale_order_calendar_state_report_pivot" model="ir.ui.view">
        <field name="name">Sale order calendar state report: Pivot</field>
        <field name="model">sale.order.calendar.state.report</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="production_id" type="row" />
                <field name="calendar_state" type="row" />
                <field name="production_date_planned_start" type="col" />
                <field name="production_qty" type="measure" />
                <field name="amount_untaxed" type="measure" />
            </pivot>
        </field>
    </record>

    <record id="action_sale_order_calendar_state_report" model="ir.actions.act_window">
        <field name="name">Sale Order Calendar State Report</field>
        <field name="res_model">sale.order.calendar.state.report</field>
        <field name="view_mode">graph,pivot</field>
        <field name="context">{"search_default_filter_production_date_planned_start": 1,
                               "search_default_groupby_calendar_state": 1,
                               "search_default_groupby_production_date_planned_start": 1}</field>
    </record>

    <menuitem
    id="menu_sale_order_calendar_state_report"
    parent="sale.menu_sale_report"
    action="action_sale_order_calendar_state_report"
    name="Sale Order Calendar State"
  />
</odoo>
